{
  // metaphases: SPA + API under mutaafaziz.com/metaphases/ (same pattern as cold-gas / outatime).
  // The route takes precedence over the mutaafaziz.com Custom Domain (the personal site).
  // Operator-owned file (agents/control.json → frozen_paths).
  "name": "metaphases",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "preview_urls": true,
  "previews": {},
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "routes": [{ "pattern": "mutaafaziz.com/metaphases*", "zone_name": "mutaafaziz.com" }],
  // The free default brain for Metaphases' AI features: Workers AI through Prompter (github.com/mutaaf/prompter),
  // which shares the account's free allowance between apps (Metaphases: 1,250 neurons a day guaranteed). BYOK keys bypass it.
  "services": [{ "binding": "AI", "service": "prompter", "props": { "app": "metaphases" } }],
  // Moon Club support inbox (/api/kids/support): parents' questions, 180-day TTL, read with `npm run support:inbox`.
  "kv_namespaces": [{ "binding": "SUPPORT", "id": "2f2fec9876f6472e9d8d3018223a58ba" }],
  "observability": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION" }
}
