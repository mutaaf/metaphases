{
  "name": "metaphases",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "up": "bash scripts/up.sh",
    "dev": "bash scripts/up.sh --dev",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "deploy": "npm run build && wrangler deploy",
    "universe": "python3 scripts/build_universe.py",
    "test": "vitest run",
    "e2e": "playwright test",
    "lint": "tsc -b",
    "check:fast": "node scripts/check-backlog.mjs && npm run lint && npm test && vite build",
    "check": "npm run check:fast && playwright test",
    "refresh:data": "python3 scripts/build_universe.py && python3 scripts/refresh_etfs.py",
    "export:kids": "npx -y tsx scripts/export-kids-content.ts"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.40.0"
  }
}
